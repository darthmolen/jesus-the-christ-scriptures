<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:JesusTheChrist.App"
             x:Class="JesusTheChrist.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Reading comfort: scripture text binds to this via DynamicResource;
                 SettingsViewModel updates it through the AppearanceApplier. -->
            <x:Double x:Key="ReadingFontSize">16</x:Double>

            <!-- Hold-to-copy highlight: a verse line's background ramps to this while held.
                 Two keys rather than an AppThemeBinding because the ramp is animated from
                 code-behind, where a markup extension does not resolve. -->
            <Color x:Key="VerseHoldHighlightLight">#1C6FD0</Color>
            <Color x:Key="VerseHoldHighlightDark">#5FA8F5</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
